# Copia este archivo como ".env" (junto a run.py) y ajusta lo que necesites.
# Precedencia: variable de entorno real > .env > valor por defecto.
# Todo es opcional: lo que no pongas usa el valor por defecto indicado.
# Reinicia el servidor tras cambiar algo.

# --- Red ---
# Por defecto el servidor escucha SOLO en este equipo. Para abrirlo a la red local arranca con
#   python run.py --lan      (el flag manda sobre TRANSLATOR_HOST)
# TRANSLATOR_HOST=local              # local | lan | IP concreta (p. ej. 192.168.1.50)
TRANSLATOR_HOST=local
TRANSLATOR_PORT=9500

# --- Cola y límites ---
TRANSLATOR_MAX_PENDING_REQUESTS=16   # peticiones en curso + en cola; al superarlo -> 503
TRANSLATOR_MAX_BATCH_ITEMS=0         # textos por /translate/batch. 0 = SIN límite (capítulos completos)
TRANSLATOR_MAX_BATCH_CHARS=100000    # caracteres totales por batch; se ignora si MAX_BATCH_ITEMS=0
TRANSLATOR_MAX_TEXT_CHARS=20000      # caracteres por texto (siempre se aplica)
TRANSLATOR_MAX_BODY_MB=20            # tamaño máximo de una petición (413 si se supera)

# --- Rendimiento ---
TRANSLATOR_DEVICE=auto               # auto | cpu | cuda
TRANSLATOR_BATCH_SIZE=8              # fragmentos por pasada; bájalo si falta RAM
TRANSLATOR_CHUNK_TARGET_TOKENS=200   # tamaño objetivo de cada fragmento (mínimo 16)
TRANSLATOR_MAX_LOADED_MODELS=1       # modelos simultáneos en RAM
TRANSLATOR_PRELOAD_MODEL=opus-mt-en-es   # cargar este modelo al arrancar

# --- Seguridad ---
# TRANSLATOR_API_KEY=cambia-esto     # exige la cabecera X-API-Key
# TRANSLATOR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Modelos y log ---
# TRANSLATOR_MODELS_DIR=D:\Models    # por defecto ./models
TRANSLATOR_CONSOLE_LOG=simple        # simple = resumen en consola | full = como el archivo
TRANSLATOR_LOG_LEVEL=INFO
TRANSLATOR_LOG_FILE=translator.log   # "off" lo desactiva
TRANSLATOR_LOG_MAX_MB=10
TRANSLATOR_LOG_BACKUPS=5
TRANSLATOR_LOG_TEXT_PREVIEW=0        # 0 = nunca se registra el texto